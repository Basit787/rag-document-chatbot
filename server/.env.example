# HTTP port for the NestJS API (served under /api)
PORT=3001

# Postgres from docker compose (host port 5433)
DATABASE_URL=postgres://chatbot:chatbot@localhost:5433/chatbot

# Ollama from docker compose (host port 11435)
OLLAMA_BASE_URL=http://localhost:11435
# Default chat model
OLLAMA_MODEL=llama3.2
# Embedding model used to index uploaded documents and search them
OLLAMA_EMBED_MODEL=nomic-embed-text

# Secret for signing session tokens. Leave empty to use a random one per boot
# (every restart then signs everyone out). Generate one with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000

# API docs at /api/docs: on unless NODE_ENV=production; set true/false to override
SWAGGER_ENABLED=
NODE_ENV=development
